{
  "risks": [
    {
      "id": "objective",
      "severity": "high",
      "finding": "A wins one composite development objective, not every metric. Ranking changes with old/new priority and FPR penalty.",
      "evidence": "objective_sensitivity in this file"
    },
    {
      "id": "threshold_shift",
      "severity": "high",
      "finding": "Threshold_source_ids only calib_old; calib_new normals are not used for current threshold. New FPR around58% is a deployment failure.",
      "evidence": "research_ABCDE/engine.py evaluate_development"
    },
    {
      "id": "one_center",
      "severity": "hypothesis",
      "finding": "Single standardized centroid can misrepresent multiple normal modes. Must test alternative heads on exactly frozen embeddings before blaming training."
    },
    {
      "id": "test_reuse",
      "severity": "high",
      "finding": "Same heldout pools were opened in V2 and A-E. Further comparison is exploratory, not a new untouched confirmation."
    },
    {
      "id": "calibration_provenance",
      "severity": "high",
      "finding": "Initial models used original validation pools for early stopping before those pools were divided into local/calibration/decision. No exact split-conformal coverage guarantee is claimed."
    },
    {
      "id": "paper_code_shrink",
      "severity": "high",
      "finding": "Paper Eq4/Algorithm1 uses squared latent L2. Upstream code uses mean unsquared L2 norm. Repository-faithful reproduction is not proof of paper-faithful mathematical implementation.",
      "paper": "https://arxiv.org/html/2410.14121v2",
      "code": "src/Model/Shrink_Autoencoder.py:152",
      "numeric_example": "latent=(3,4): unsquared norm=5; squared norm=25"
    },
    {
      "id": "paper_code_sharing",
      "severity": "high",
      "finding": "Paper GatewayUpdate receives initial encoder/decoder weights; upstream main passes shared aggregator model sequentially. Preserved, not silently fixed."
    },
    {
      "id": "early_stop",
      "severity": "medium",
      "finding": "Two independent global if statements increment patience even on improvement. Preserved upstream behavior changes actual training budget."
    },
    {
      "id": "development_attack_reuse",
      "severity": "medium",
      "finding": "Old/new development domains use same attack pool, so development TPRs are identical by design. This is not unseen-attack validation."
    },
    {
      "id": "synthetic_severity",
      "severity": "high",
      "finding": "A/B split is defined by development PC1 median, not actual chronology. Initial new AUC<0.5 can be driven by constructed feature shift. Need independent real chronological/device data for generalization."
    },
    {
      "id": "clip",
      "severity": "hypothesis",
      "finding": "Fixed input clip may erase shifted-feature distinctions. Quantify saturation separately for old/new normal and attacks and compare latent vs input-space heads."
    },
    {
      "id": "five_seeds",
      "severity": "medium",
      "finding": "Five seeds share a single split. Client/seed results are correlated; do not claim statistical significance or general deployment performance."
    },
    {
      "id": "threshold_numeric_ties",
      "severity": "medium",
      "finding": "Ten old-domain predictions changed under <1e-6 score arithmetic differences at exactly the threshold. Failed strict baseline run preserved; internal comparisons share freshly recomputed embeddings."
    },
    {
      "id": "attack_assisted_selection",
      "severity": "high",
      "finding": "Head fitting uses only normals, but operating-point/method selection uses labeled development attacks. This is not attack-label-free model selection."
    },
    {
      "id": "verifier_poisoning",
      "severity": "high",
      "finding": "~4.79% actual attack reference contamination reduced new development TPR from89.3% to19.3%. Clean calibration FPR stayed near7%; low FPR alone does not reveal poisoning."
    }
  ],
